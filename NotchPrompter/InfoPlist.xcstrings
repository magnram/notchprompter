{
  "sourceLanguage" : "en",
  "strings" : {
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - usage description shown by macOS when asking for permission",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter filmer dig kun, når du starter en optagelse. Filmen gemmes i mappen Film og forlader aldrig din Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter filmt dich nur, wenn du eine Aufnahme startest. Das Video wird in deinem Ordner „Filme“ gesichert und verlässt deinen Mac nie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter films you only when you press Record. The movie is saved in your Movies folder and never leaves your Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter solo te graba cuando inicias una grabación. El vídeo se guarda en tu carpeta Vídeos y nunca sale de tu Mac."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter kuvaa sinua vain, kun aloitat tallennuksen. Video tallennetaan Elokuvat-kansioon, eikä se koskaan poistu Macistasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter ne vous filme que lorsque vous lancez un enregistrement. La vidéo est enregistrée dans votre dossier Vidéos et ne quitte jamais votre Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter ti riprende solo quando avvii una registrazione. Il filmato viene salvato nella cartella Filmati e non lascia mai il tuo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompterがあなたを撮影するのは、収録を開始したときだけです。ムービーは“ムービー”フォルダに保存され、Macの外に出ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter는 녹화를 시작할 때만 사용자를 촬영합니다. 동영상은 동영상 폴더에 저장되며 Mac 밖으로 전송되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter filmer deg bare når du starter et opptak. Filmen arkiveres i Filmer-mappen og forlater aldri Macen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter filmt je alleen als je een opname start. De video wordt in je map 'Films' bewaard en verlaat je Mac nooit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter filmuje Cię tylko wtedy, gdy zaczniesz nagrywanie. Film jest zapisywany w folderze Filmy i nigdy nie opuszcza tego Maca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O NotchPrompter só filma você quando você inicia uma gravação. O vídeo é salvo na sua pasta Filmes e nunca sai do seu Mac."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O NotchPrompter só o filma quando inicia uma gravação. O vídeo é guardado na pasta Filmes e nunca sai do Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter снимает вас, только когда вы начинаете запись. Видео сохраняется в папке «Фильмы» и никогда не покидает ваш Mac."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter filmar dig bara när du startar en inspelning. Filmen sparas i mappen Filmer och lämnar aldrig din Mac."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter sizi yalnızca kayda başladığınızda çeker. Video, Filmler klasörünüze kaydedilir ve Mac’inizden asla çıkmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter знімає вас, лише коли ви починаєте запис. Відео зберігається в папці «Відео» і ніколи не залишає ваш Mac."
