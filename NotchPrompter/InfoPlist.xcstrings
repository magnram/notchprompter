        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter 仅在你开始录制时拍摄你。影片会存储在“影片”文件夹中，绝不会离开你的 Mac。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter 只會在你開始錄影時拍攝你。影片會儲存在「影片」檔案夾中，絕不會離開你的 Mac。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - usage description shown by macOS when asking for permission",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter lytter, så manuskriptet kan følge din stemme. Tale genkendes på din Mac. Lyd gemmes kun, mens du optager."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter hört zu, damit das Skript deiner Stimme folgen kann. Die Sprache wird auf deinem Mac erkannt. Ton wird nur gesichert, während du aufnimmst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter listens so the script can follow your voice. Speech is recognised on your Mac. Audio is saved only when you press Record."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter te escucha para que el guion siga tu voz. El habla se reconoce en tu Mac. El audio solo se guarda mientras grabas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter kuuntelee, jotta käsikirjoitus voi seurata ääntäsi. Puhe tunnistetaan Macillasi. Ääntä tallennetaan vain tallennuksen aikana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter vous écoute pour que le script suive votre voix. La parole est reconnue sur votre Mac. Le son n’est enregistré que pendant un enregistrement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter ascolta perché il copione possa seguire la tua voce. Il parlato viene riconosciuto sul tuo Mac. L’audio viene salvato solo mentre registri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompterは、原稿があなたの声に合わせて進むように音声を聞き取ります。音声の認識はMac上で行われます。オーディオが保存されるのは収録中だけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter는 대본이 사용자의 목소리를 따라갈 수 있도록 소리를 듣습니다. 음성은 Mac에서 인식됩니다. 오디오는 녹화 중에만 저장됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter lytter slik at manuset kan følge stemmen din. Tale gjenkjennes på Macen. Lyd arkiveres bare mens du tar opp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter luistert zodat het script je stem kan volgen. Spraak wordt op je Mac herkend. Audio wordt alleen bewaard terwijl je opneemt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter słucha, aby tekst mógł podążać za Twoim głosem. Mowa jest rozpoznawana na tym Macu. Dźwięk jest zapisywany tylko podczas nagrywania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O NotchPrompter escuta para que o roteiro acompanhe a sua voz. A fala é reconhecida no seu Mac. O áudio só é salvo enquanto você grava."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O NotchPrompter ouve para que o guião acompanhe a sua voz. A fala é reconhecida no Mac. O áudio só é guardado enquanto grava."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter слушает, чтобы текст следовал за вашим голосом. Речь распознаётся на вашем Mac. Звук сохраняется, только пока идёт запись."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter lyssnar så att manuset kan följa din röst. Talet känns igen på din Mac. Ljud sparas bara medan du spelar in."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter, metnin sesinizi takip edebilmesi için dinler. Konuşma Mac’inizde tanınır. Ses yalnızca kayıt sırasında kaydedilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter слухає, щоб текст рухався за вашим голосом. Мовлення розпізнається на вашому Mac. Звук зберігається, лише поки триває запис."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter 会聆听你的声音，让讲稿跟随你的朗读滚动。语音在你的 Mac 上识别。仅在录制时才会存储音频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter 會聆聽你的聲音，讓講稿跟著你的朗讀捲動。語音會在你的 Mac 上辨識。只有在錄影時才會儲存音訊。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
