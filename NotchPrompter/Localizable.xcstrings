          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talen gjenkjennes på Macen og lagres aldri."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spraak wordt op je Mac herkend en nooit bewaard."
