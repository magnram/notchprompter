    "Drag the edges or corners of the prompter to resize it." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træk i prompterens kanter eller hjørner for at ændre størrelsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh an den Rändern oder Ecken des Prompters, um seine Größe zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra los bordes o las esquinas del teleprompter para cambiar su tamaño."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muuta prompterin kokoa vetämällä sen reunoista tai kulmista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser les bords ou les coins du prompteur pour le redimensionner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina i bordi o gli angoli del prompter per ridimensionarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロンプターの端や角をドラッグすると、サイズを変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프롬프터의 가장자리나 모서리를 드래그하여 크기를 조절하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra i kantene eller hjørnene på prompteren for å endre størrelsen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep aan de randen of hoeken van de prompter om het formaat te wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij krawędzie lub rogi promptera, aby zmienić jego rozmiar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste as bordas ou os cantos do teleprompter para redimensioná-lo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrasta as margens ou os cantos do teleponto para o redimensionar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потяните за края или углы суфлёра, чтобы изменить его размер."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra i prompterns kanter eller hörn för att ändra storleken."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prompter’ı yeniden boyutlandırmak için kenarlarını veya köşelerini sürükleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потягніть за краї або кути суфлера, щоб змінити його розмір."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移提词器的边缘或角落即可调整大小。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移提詞機的邊緣或角落即可調整大小。"
          }
        }
      }
    },
