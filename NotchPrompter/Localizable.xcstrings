    "Read with Voice" : {
      "comment" : "Prominent toolbar button: show the script in the prompter and start voice-follow. Keep it short (max ~20 characters).",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læs med stemmen"
          }
        },
        "de" : {
