    "NotchPrompter needs the camera to record you. Turn it on for NotchPrompter in System Settings → Privacy & Security → Camera." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter skal bruge kameraet for at optage dig. Slå det til for NotchPrompter i Systemindstillinger → Anonymitet & sikkerhed → Kamera."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter braucht die Kamera, um dich aufzunehmen. Erlaube NotchPrompter den Zugriff in Systemeinstellungen → Datenschutz & Sicherheit → Kamera."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter necesita la cámara para grabarte. Actívala para NotchPrompter en Ajustes del Sistema → Privacidad y seguridad → Cámara."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter tarvitsee kameraa kuvatakseen sinua. Laita se päälle NotchPrompterille kohdassa Järjestelmäasetukset → Tietosuoja ja suojaus → Kamera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter a besoin de la caméra pour vous filmer. Activez-la pour NotchPrompter dans Réglages Système → Confidentialité et sécurité → Caméra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter ha bisogno della fotocamera per riprenderti. Attivala per NotchPrompter in Impostazioni di Sistema → Privacy e sicurezza → Fotocamera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompterで収録するにはカメラが必要です。「システム設定」→「プライバシーとセキュリティ」→「カメラ」でNotchPrompterをオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter에서 녹화하려면 카메라가 필요합니다. 시스템 설정 → 개인정보 보호 및 보안 → 카메라에서 NotchPrompter를 켜세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter trenger kameraet for å filme deg. Slå det på for NotchPrompter i Systeminnstillinger → Personvern og sikkerhet → Kamera."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter heeft de camera nodig om je op te nemen. Zet deze aan voor NotchPrompter in Systeeminstellingen → Privacy en beveiliging → Camera."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter potrzebuje kamery, aby cię nagrywać. Włącz ją dla NotchPromptera w Ustawieniach systemowych → Prywatność i ochrona → Kamera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O NotchPrompter precisa da câmera para gravar você. Ative-a para o NotchPrompter em Ajustes do Sistema → Privacidade e Segurança → Câmera."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O NotchPrompter precisa da câmara para te gravar. Ativa-a para o NotchPrompter em Definições do Sistema → Privacidade e segurança → Câmara."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter нужна камера, чтобы записывать вас. Включите её для NotchPrompter в разделе «Системные настройки» → «Конфиденциальность и безопасность» → «Камера»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter behöver kameran för att spela in dig. Slå på den för NotchPrompter i Systeminställningar → Integritet och säkerhet → Kamera."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter’ın sizi kaydetmek için kameraya ihtiyacı var. Sistem Ayarları → Gizlilik ve Güvenlik → Kamera bölümünde NotchPrompter için açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter потрібна камера, щоб записувати вас. Увімкніть її для NotchPrompter у Системних параметрах → Приватність і безпека → Камера."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter 需要使用摄像头来录制你。请在“系统设置”→“隐私与安全性”→“相机”中为 NotchPrompter 打开此权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter 需要使用相機來錄下你。請在「系統設定」→「隱私權與安全性」→「相機」中為 NotchPrompter 開啟此權限。"
          }
        }
      }
    },
    "NotchPrompter needs the microphone to record your voice. Turn it on for NotchPrompter in System Settings → Privacy & Security → Microphone." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter skal bruge mikrofonen for at optage din stemme. Slå den til for NotchPrompter i Systemindstillinger → Anonymitet & sikkerhed → Mikrofon."
