    "Speech is recognised on your Mac and never saved." : {
      "comment" : "Onboarding, privacy note.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tale genkendes på din Mac og gemmes aldrig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprache wird auf deinem Mac erkannt und nie gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El habla se reconoce en tu Mac y nunca se guarda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puhe tunnistetaan Macillasi, eikä sitä koskaan tallenneta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La parole est reconnue sur votre Mac et n’est jamais enregistrée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il parlato viene riconosciuto sul tuo Mac e non viene mai salvato."
