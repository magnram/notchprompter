    "Records the screen with your voice. The prompter is left out while it's hidden from recordings." : {
      "comment" : "Settings: what the Screen recording mode does",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optager skærmen med din stemme. Prompteren er ikke med, så længe den er skjult i optagelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimmt den Bildschirm mit deiner Stimme auf. Der Prompter fehlt darin, solange er in Aufnahmen ausgeblendet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graba la pantalla con tu voz. El teleprompter no aparece mientras esté oculto en las grabaciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallentaa näytön ja äänesi. Prompteri jätetään pois, kun se on piilotettu tallenteista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre l’écran avec votre voix. Le prompteur n’y apparaît pas s’il est masqué dans les enregistrements."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra lo schermo con la tua voce. Il prompter non compare se è nascosto nelle registrazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面とあなたの声を収録します。収録で非表示に設定しているあいだは、プロンプターは映りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면과 목소리를 녹화합니다. 녹화에서 가려지도록 설정한 동안에는 프롬프터가 포함되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tar opp skjermen med stemmen din. Prompteren er ikke med så lenge den er skjult i opptak."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neemt het scherm op met je stem. De prompter is niet te zien zolang hij verborgen is voor opnamen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagrywa ekran razem z twoim głosem. Prompter jest pomijany, gdy jest ukryty przed nagraniami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grava a tela com a sua voz. O teleprompter fica de fora enquanto estiver oculto nas gravações."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grava o ecrã com a tua voz. O teleponto fica de fora enquanto estiver oculto nas gravações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывает экран с вашим голосом. Суфлёр не виден, пока он скрыт от записей."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spelar in skärmen med din röst. Promptern syns inte så länge den är gömd för inspelningar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekranı sesinizle birlikte kaydeder. Prompter kayıtlardan gizliyken görünmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записує екран із вашим голосом. Суфлера не видно, поки він схований від записів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录制屏幕和你的声音。如果提词器设为在录制内容中隐藏，录制中不会出现提词器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
