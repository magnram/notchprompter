    "A small preview beside the prompter. Drag it anywhere. It is never in screen recordings." : {
      "comment" : "Settings toggle subtitle",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En lille forhåndsvisning ved siden af prompteren. Træk den hvorhen du vil. Den er aldrig med i skærmoptagelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine kleine Vorschau neben dem Prompter. Zieh sie an eine beliebige Stelle. Sie ist nie in Bildschirmaufnahmen zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una pequeña vista previa junto al teleprompter. Arrástrala a donde quieras. Nunca aparece en las grabaciones de pantalla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pieni esikatselu prompterin vieressä. Vedä se mihin haluat. Se ei koskaan näy näytön tallenteissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un petit aperçu à côté du prompteur. Faites-le glisser où vous voulez. Il n’apparaît jamais dans les enregistrements de l’écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una piccola anteprima accanto al prompter. Trascinala dove vuoi. Non compare mai nelle registrazioni dello schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロンプターの横に小さなプレビューを表示します。好きな場所にドラッグできます。画面収録には映りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프롬프터 옆에 작은 미리보기가 나타납니다. 원하는 곳으로 드래그할 수 있습니다. 화면 녹화에는 절대 나오지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En liten forhåndsvisning ved siden av prompteren. Dra den dit du vil. Den er aldri med i skjermopptak."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een kleine voorvertoning naast de prompter. Sleep hem waar je wilt. Hij is nooit te zien in schermopnamen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mały podgląd obok promptera. Przeciągnij go w dowolne miejsce. Nigdy nie pojawia się w nagraniach ekranu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma pequena pré-visualização ao lado do teleprompter. Arraste para onde quiser. Ela nunca aparece nas gravações de tela."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma pequena pré-visualização ao lado do teleponto. Arrasta-a para onde quiseres. Nunca aparece nas gravações do ecrã."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маленькое окно рядом с суфлёром. Его можно перетащить куда угодно. В записи экрана оно не попадает."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En liten förhandsvisning bredvid promptern. Dra den vart du vill. Den syns aldrig i skärminspelningar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prompter’ın yanında küçük bir önizleme. İstediğiniz yere sürükleyin. Ekran kayıtlarında asla görünmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маленьке вікно поруч із суфлером. Його можна перетягнути куди завгодно. У записи екрана воно не потрапляє."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提词器旁边的小预览窗口。可以拖到任何位置。它不会出现在屏幕录制中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提詞機旁邊的小預覽視窗。可以拖到任何位置。它不會出現在螢幕錄影中。"
          }
        }
      }
    },
