          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lees met stem"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czytaj głosem"
          }
        },
