    "Allow Microphone and Speech Recognition" : {
      "comment" : "Large button in onboarding that asks for permissions (title case in English; use your language’s button capitalization).",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad mikrofon og talegenkendelse"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon und Spracherkennung erlauben"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir micrófono y reconocimiento de voz"
          }
        },
