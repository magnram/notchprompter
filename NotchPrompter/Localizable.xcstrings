    "Write or paste what you want to say.\nBlank lines become new paragraphs in the prompter." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv eller indsæt det, du vil sige.\nTomme linjer bliver til nye afsnit i prompteren."
          }
        },
        "de" : {
          "stringUnit" : {
