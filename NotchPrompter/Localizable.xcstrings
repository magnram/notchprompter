    "Film yourself while you read. Takes go to Movies › NotchPrompter." : {
      "comment" : "Onboarding. Use the Finder folder name from the glossary. Keep “›”.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Film dig selv, mens du læser. Optagelserne havner i Film › NotchPrompter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Film dich, während du liest. Aufnahmen landen in Filme › NotchPrompter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grábate mientras lees. Las tomas se guardan en Vídeos › NotchPrompter."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuvaa itsesi lukiessasi. Otot tallentuvat kansioon Elokuvat › NotchPrompter."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filmez-vous pendant votre lecture. Les prises sont enregistrées dans Vidéos › NotchPrompter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riprenditi mentre leggi. Le riprese vengono salvate in Filmati › NotchPrompter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読みながら自分を撮影できます。テイクは「ムービー › NotchPrompter」に保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "읽는 동안 자신을 촬영하세요. 테이크는 동영상 › NotchPrompter에 저장됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Film deg selv mens du leser. Opptakene havner i Filmer › NotchPrompter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Film jezelf terwijl je leest. Opnamen komen in Films › NotchPrompter."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagrywaj się podczas czytania. Ujęcia trafiają do Filmy › NotchPrompter."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grave um vídeo seu enquanto lê. As gravações vão para Filmes › NotchPrompter."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grava-te enquanto lês. As gravações vão para Filmes › NotchPrompter."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снимайте себя во время чтения. Дубли сохраняются в папке Фильмы › NotchPrompter."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filma dig själv medan du läser. Tagningarna hamnar i Filmer › NotchPrompter."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okurken kendinizi çekin. Çekimler Filmler › NotchPrompter klasörüne kaydedilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знімайте себе, поки читаєте. Дублі зберігаються в папці Відео › NotchPrompter."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
