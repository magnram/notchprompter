# Releasing NotchPrompter to the Mac App Store, and as a notarized DMG
# for Macs that block the App Store (the `dmg` lane).
#
# Nothing here holds a secret. Every lane signs in with an App Store Connect
# API key read from the environment (ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH),
# the same key the minigolf app uses. No lane submits for review on its own
# except `submit_review`, which you run by hand.

Encoding.default_external = Encoding::UTF_8
Encoding.default_internal = Encoding::UTF_8
ENV["LANG"] ||= "en_US.UTF-8"
ENV["LC_ALL"] ||= "en_US.UTF-8"

default_platform(:mac)

ROOT = File.expand_path("..", __dir__)
METADATA = "#{ROOT}/fastlane/metadata"
SCREENSHOTS = "#{ROOT}/fastlane/screenshots"
PKG = "#{ROOT}/fastlane/builds/NotchPrompter.pkg"

platform :mac do
  def connect
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
      duration: 1200,
      in_house: false
    )
  end

  # xcodebuild signs in with the same key, so automatic signing can make the
  # distribution certificates and profile without an Apple ID in Xcode.
  def key_args
    "-allowProvisioningUpdates " \
      "-authenticationKeyPath #{File.expand_path(ENV.fetch('ASC_KEY_PATH'))} " \
      "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')} " \
      "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}"
  end

  def review_information
    UI.user_error!("Set APP_REVIEW_PHONE to a reachable reviewer contact number.") if ENV["APP_REVIEW_PHONE"].to_s.strip.empty?
    {
      first_name: "Magnus", last_name: "Ramm", email_address: "magnus.ramm@gmail.com",
      phone_number: ENV["APP_REVIEW_PHONE"], demo_account_required: false,
      notes: File.read("#{METADATA}/review_information/notes.txt")
    }
  end

  desc "Archive and export a signed installer package for the Mac App Store"
  lane :build do
    # A failed export must not leave the last package behind for an upload to pick up.
    FileUtils.rm_f(PKG)
    # Automatic signing reuses an old Mac App Store profile made before iCloud was turned on,
    # so the export signs by hand with a profile fetched (or made) with the key.
    connect
    # Its own name, as the iPhone app's profile already has the default one.
    get_provisioning_profile(app_identifier: "com.magnusramm.NotchPrompter", platform: "macos",
                             provisioning_name: "com.magnusramm.NotchPrompter Mac AppStore",
                             output_path: File.dirname(PKG))
    build_mac_app(
      project: "#{ROOT}/NotchPrompter.xcodeproj",
      scheme: "NotchPrompter",
      configuration: "Release",
      export_method: "app-store",
      export_options: { signingStyle: "manual", teamID: "A7C4MM99VP",
                        provisioningProfiles: { "com.magnusramm.NotchPrompter" => lane_context[SharedValues::SIGH_NAME] } },
      # Newer fastlane passes xcargs to the export too; giving them twice fails.
      xcargs: key_args,
      output_directory: File.dirname(PKG),
      output_name: "NotchPrompter"
    )
  end

  desc "Update the App Store text, screenshots and review notes, and pick a build. No submit."
  lane :metadata do |options|
    # Name the version on purpose, so text for the next version never lands in
    # one that is already in review: fastlane mac metadata version:1.1
    UI.user_error!("Pass the App Store version, e.g. version:1.1") unless options[:version]
    connect
    review = ENV["APP_REVIEW_PHONE"].to_s.strip.empty? ? {} : { app_review_information: review_information }
    upload_to_app_store(
      platform: "osx",
      metadata_path: METADATA,
      screenshots_path: SCREENSHOTS,
      overwrite_screenshots: true,
      app_rating_config_path: "#{METADATA}/age_rating.json",
      app_version: options[:version].to_s,
      build_number: options[:build_number]&.to_s,
      **review,
      skip_binary_upload: true,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      force: true
    )
    # Apple asks this before review; fastlane has no option for it. The app ships
    # only its own MIT-licensed code and text.
    Spaceship::ConnectAPI::App.find("com.magnusramm.NotchPrompter")
      .update(attributes: { contentRightsDeclaration: "DOES_NOT_USE_THIRD_PARTY_CONTENT" })
  end

  desc "Build, then upload the package with its text and screenshots. Does not submit."
  lane :release do |options|
    UI.user_error!("Pass the App Store version, e.g. version:1.1") unless options[:version]
    build
    connect
    upload_to_app_store(
      platform: "osx",
      app_version: options[:version].to_s,
      pkg: PKG,
      metadata_path: METADATA,
      screenshots_path: SCREENSHOTS,
      overwrite_screenshots: true,
      app_rating_config_path: "#{METADATA}/age_rating.json",
      app_review_information: review_information,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      force: true
    )
    UI.success("Uploaded. Run `fastlane mac submit_review` when the build has processed.")
  end

  desc "Submit the version for review, with manual release"
  lane :submit_review do
    connect
    upload_to_app_store(
      platform: "osx",
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      submission_information: { add_id_info_uses_idfa: false, export_compliance_uses_encryption: false },
      precheck_include_in_app_purchases: false,
      force: true
    )
  end
end

platform :mac do
  desc "Upload fastlane/builds/NotchPrompter.pkg only. No text, no submit."
  lane :upload_pkg do
    connect
    upload_to_app_store(
      platform: "osx",
      pkg: PKG,
      # Only upload. Without this, deliver renames the version in App Store Connect
      # after the package, even one that is waiting for review.
      skip_app_version_update: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      force: true
    )
  end
end

platform :mac do
  desc "Attach an uploaded build to the editable App Store version, without submitting"
  lane :select_build do |options|
    connect
    platform = Spaceship::ConnectAPI::Platform::MAC_OS
    app = Spaceship::ConnectAPI::App.find("com.magnusramm.NotchPrompter")
    version = app.get_edit_app_store_version(platform: platform)
    UI.user_error!("No editable App Store version found") unless version
    build = Spaceship::ConnectAPI::Build.all(
      app_id: app.id, version: version.version_string,
      build_number: options.fetch(:build_number).to_s, platform: platform
    ).first
    UI.user_error!("Build #{options[:build_number]} is not available yet") unless build
    version.select_build(build_id: build.id)
    UI.success("Selected build #{version.version_string} (#{build.version}) without submitting it for review")
  end
end

# A notarized DMG for Macs without the App Store, for GitHub Releases.
platform :mac do
  desc "Build a Developer ID app, notarize it and put it in fastlane/builds/NotchPrompter-<version>.dmg"
  lane :dmg do
    # Only the Account Holder can make this certificate, and an API key cannot,
    # so it is made once in Xcode and lives in the keychain.
    identities = sh("security find-identity -v -p codesigning", log: false)
    identity = identities[/"(Developer ID Application: [^"]+\(A7C4MM99VP\))"/, 1]
    UI.user_error!("No Developer ID Application certificate in the keychain. Make one in Xcode: " \
                   "Settings → Accounts → Manage Certificates → + → Developer ID Application.") unless identity

    out = "#{File.dirname(PKG)}/developer-id"
    FileUtils.rm_rf(out)
    connect
    # iCloud sync needs a profile, so Developer ID gets its own like the App Store build.
    get_provisioning_profile(app_identifier: "com.magnusramm.NotchPrompter", platform: "macos",
                             developer_id: true,
                             provisioning_name: "com.magnusramm.NotchPrompter Developer ID",
                             output_path: out)
    build_mac_app(
      project: "#{ROOT}/NotchPrompter.xcodeproj",
      scheme: "NotchPrompter",
      configuration: "Release",
      export_method: "developer-id",
      export_options: { signingStyle: "manual", teamID: "A7C4MM99VP",
                        provisioningProfiles: { "com.magnusramm.NotchPrompter" => lane_context[SharedValues::SIGH_NAME] } },
      xcargs: key_args,
      output_directory: out,
      output_name: "NotchPrompter"
    )
    app = Dir["#{out}/*.app"].first
    UI.user_error!("The export made no app in #{out}") unless app

    version = sh("/usr/libexec/PlistBuddy", "-c", "Print :CFBundleShortVersionString",
                 "#{app}/Contents/Info.plist", log: false).strip
    dmg = "#{File.dirname(PKG)}/NotchPrompter-#{version}.dmg"
    FileUtils.rm_f(dmg)
    # The window shows the app next to a link to Applications, to drag it across.
    stage = "#{out}/dmg"
    sh("ditto", app, "#{stage}/NotchPrompter.app")
    File.symlink("/Applications", "#{stage}/Applications")
    sh("hdiutil", "create", "-volname", "NotchPrompter", "-srcfolder", stage, "-format", "UDZO", "-ov", dmg)
    sh("codesign", "--sign", identity, "--timestamp", dmg)

    # Notarizing the DMG covers the app inside it. The ticket is stapled to the DMG,
    # so it opens without a network check.
    notarize(package: dmg, api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY], print_log: true)
    sh("spctl", "--assess", "--type", "open", "--context", "context:primary-signature", "--verbose", dmg)
    UI.success("Notarized #{dmg}")
    UI.message("Publish it with: gh release create v#{version} '#{dmg}' --title 'NotchPrompter #{version}'")
  end
end

platform :mac do
  desc "Show the App Store versions and uploaded builds. Changes nothing."
  lane :status do
    connect
    app = Spaceship::ConnectAPI::App.find("com.magnusramm.NotchPrompter")
    app.get_app_store_versions(includes: "build").each do |v|
      UI.message("version #{v.version_string}: #{v.app_store_state}, build #{v.build&.version || '-'}")
    end
    Spaceship::ConnectAPI::Build.all(app_id: app.id).each do |b|
      UI.message("build #{b.app_version} (#{b.version}): #{b.processing_state}")
    end
  end
end
