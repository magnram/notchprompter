    "NotchPrompter needs Speech Recognition to follow your voice. Turn it on for NotchPrompter in System Settings → Privacy & Security → Speech Recognition." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter skal bruge talegenkendelse for at følge din stemme. Slå den til for NotchPrompter i Systemindstillinger → Anonymitet & sikkerhed → Talegenkendelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter braucht die Spracherkennung, um deiner Stimme zu folgen. Erlaube NotchPrompter den Zugriff in Systemeinstellungen → Datenschutz & Sicherheit → Spracherkennung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter necesita el reconocimiento de voz para seguir tu voz. Actívalo para NotchPrompter en Ajustes del Sistema → Privacidad y seguridad → Reconocimiento de voz."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter tarvitsee puheentunnistusta seuratakseen ääntäsi. Laita se päälle NotchPrompterille kohdassa Järjestelmäasetukset → Tietosuoja ja suojaus → Puheentunnistus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter a besoin de la reconnaissance vocale pour suivre votre voix. Activez-la pour NotchPrompter dans Réglages Système → Confidentialité et sécurité → Reconnaissance vocale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter ha bisogno del riconoscimento vocale per seguire la tua voce. Attivalo per NotchPrompter in Impostazioni di Sistema → Privacy e sicurezza → Riconoscimento vocale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "声に合わせるには音声認識が必要です。「システム設定」→「プライバシーとセキュリティ」→「音声認識」でNotchPrompterをオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter가 음성을 따라가려면 음성 인식이 필요합니다. 시스템 설정 → 개인정보 보호 및 보안 → 음성 인식에서 NotchPrompter를 켜세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter trenger talegjenkjenning for å følge stemmen din. Slå den på for NotchPrompter i Systeminnstillinger → Personvern og sikkerhet → Talegjenkjenning."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchPrompter heeft spraakherkenning nodig om je stem te volgen. Zet deze aan voor NotchPrompter in Systeeminstellingen → Privacy en beveiliging → Spraakherkenning."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
