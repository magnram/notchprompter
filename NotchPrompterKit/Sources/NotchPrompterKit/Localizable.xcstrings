    "On-device speech recognition isn't working. Turn on Dictation in Settings → General → Keyboard, or allow Apple's servers in the app's settings." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On-device speech recognition isn't working. Turn on Dictation in Settings → General → Keyboard, or allow Apple's servers in the app's settings."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talegenkendelse på enheden virker ikke. Slå Diktering til i Indstillinger → Generelt → Tastatur, eller tillad Apples servere i appens indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Spracherkennung auf dem Gerät funktioniert nicht. Aktiviere die Diktierfunktion in Einstellungen → Allgemein → Tastatur oder erlaube die Server von Apple in den Einstellungen der App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reconocimiento de voz en el dispositivo no funciona. Activa Dictado en Ajustes → General → Teclado o permite los servidores de Apple en los ajustes de la app."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laitteen oma puheentunnistus ei toimi. Laita Sanelu päälle kohdassa Asetukset → Yleiset → Näppäimistö tai salli Applen palvelimet apin asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reconnaissance vocale sur l’appareil ne fonctionne pas. Activez la dictée dans Réglages → Général → Clavier, ou autorisez les serveurs d’Apple dans les réglages de l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il riconoscimento vocale sul dispositivo non funziona. Attiva la dettatura in Impostazioni → Generali → Tastiera, oppure consenti i server di Apple nelle impostazioni dell’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイス上の音声認識が機能していません。「設定」→「一般」→「キーボード」で音声入力をオンにするか、アプリの設定でAppleのサーバを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기 내 음성 인식이 작동하지 않습니다. 설정 → 일반 → 키보드에서 받아쓰기를 켜거나, 앱 설정에서 Apple 서버를 허용하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talegjenkjenning på enheten fungerer ikke. Slå på Diktering i Innstillinger → Generelt → Tastatur, eller tillat Apples servere i innstillingene til appen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spraakherkenning op het apparaat werkt niet. Zet Dicteren aan in Instellingen → Algemeen → Toetsenbord, of sta de servers van Apple toe in de instellingen van de app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpoznawanie mowy na urządzeniu nie działa. Włącz Dyktowanie w Ustawieniach → Ogólne → Klawiatura albo zezwól na serwery Apple w ustawieniach aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
