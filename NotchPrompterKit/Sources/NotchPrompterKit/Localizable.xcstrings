{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ can't be recognised on this Mac. Allow Apple's servers in Settings → Privacy, or use Play." : {
      "comment" : "The placeholder is a language name. “Settings → Privacy” is this app's Settings window.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan ikke genkendes på denne Mac. Tillad Apples servere i Indstillinger → Anonymitet, eller brug Afspil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann auf diesem Mac nicht erkannt werden. Erlaube die Server von Apple in Einstellungen → Datenschutz oder verwende „Abspielen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede reconocer %@ en este Mac. Permite los servidores de Apple en Ajustes → Privacidad o usa Reproducir."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tätä kieltä (%@) ei voi tunnistaa tällä Macilla. Salli Applen palvelimet kohdassa Asetukset → Tietosuoja tai käytä toistoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La parole en %@ ne peut pas être reconnue sur ce Mac. Autorisez les serveurs d’Apple dans Réglages → Confidentialité, ou utilisez Lecture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il riconoscimento vocale in %@ non è disponibile su questo Mac. Consenti i server di Apple in Impostazioni → Privacy, oppure usa Riproduci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacでは%@を認識できません。「設定」→「プライバシー」でAppleのサーバを許可するか、「再生」を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에서는 %@을(를) 인식할 수 없습니다. 설정 → 개인정보 보호에서 Apple 서버를 허용하거나 재생을 사용하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan ikke gjenkjennes på denne Macen. Tillat Apples servere i Innstillinger → Personvern, eller bruk Spill av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan niet op deze Mac worden herkend. Sta de servers van Apple toe in Instellingen → Privacy, of gebruik ‘Speel af’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tego języka (%@) nie można rozpoznać na tym Macu. Zezwól na serwery Apple w Ustawieniach → Prywatność albo użyj odtwarzania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível reconhecer %@ neste Mac. Permita os servidores da Apple em Ajustes → Privacidade ou use Reproduzir."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível reconhecer %@ neste Mac. Permite os servidores da Apple em Definições → Privacidade ou usa Reproduzir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Речь не распознаётся на этом Mac (язык: %@). Разрешите серверы Apple в разделе «Настройки» → «Конфиденциальность» или нажмите «Воспроизвести»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan inte kännas igen på den här Macen. Tillåt Apples servrar i Inställningar → Integritet, eller använd Spela upp."
