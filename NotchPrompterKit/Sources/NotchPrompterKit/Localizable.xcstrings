        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мовлення не розпізнається на цьому Mac (мова: %@). Дозвольте сервери Apple у Параметрах → Приватність або натисніть «Відтворити»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法在这台 Mac 上识别%@。请在“设置”→“隐私”中允许使用 Apple 服务器，或者使用“播放”。"
